# Aplicação
NODE_ENV=development
PORT=3000
# Lista separada por vírgula. Aceita curinga de subdomínio (https://*.vercel.app).
CORS_ORIGIN=http://localhost:5173

# Banco em runtime: use o Transaction Pooler do Supabase (porta 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require

# Necessário quando a cadeia TLS do pooler não é reconhecida pelo ambiente.
# O tráfego continua criptografado, mas a cadeia do certificado não é validada.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Prisma CLI/migrations: use conexão direta ou Session Pooler (porta 5432).
DIRECT_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Tokens próprios emitidos pelo backend
JWT_SECRET=generate-a-long-random-secret

# WhatsApp Business Platform / Meta Graph API (keep real secrets out of source control)
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_HTTP_TIMEOUT_MS=10000
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_SERVICE_WINDOW_HOURS=24
WHATSAPP_DELIVERY_WORKER_ENABLED=true
WHATSAPP_DELIVERY_POLL_INTERVAL_MS=1000
WHATSAPP_DELIVERY_BATCH_SIZE=10
WHATSAPP_MAX_ATTEMPTS=5
WHATSAPP_RETRY_BASE_DELAY_MS=1000
WHATSAPP_RETRY_MAX_DELAY_MS=300000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=120
CHAT_SEND_RATE_LIMIT_MAX=30
WHATSAPP_WEBHOOK_RATE_LIMIT_MAX=60
