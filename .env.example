# ── Database ───────────────────────────────────────────────────────────────────
# OPÇÃO 1 — Prisma Postgres (Supabase): copie a URL do dashboard Supabase > Prisma Postgres
# Não precisa do `npm run prisma:dev`, conecta diretamente à nuvem
DATABASE_URL="prisma+postgres://accelerate.prisma.io/?api_key=YOUR_KEY"
#
# OPÇÃO 2 — PostgreSQL direto (Supabase ou local):
# DATABASE_URL="postgresql://postgres:senha@db.xxxxx.supabase.co:5432/postgres"
#
# NOTA: O `npm run prisma:dev` (proxy local na porta 51213) NÃO é compatível
# com Prisma Client 7.8+ usando Query Compiler. Use a URL direta acima.

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────────────────────
# Em produção defina a URL do frontend: https://seu-frontend.com
CORS_ORIGIN=*

# ── Auth (Supabase) ────────────────────────────────────────────────────────────
SUPABASE_URL=https://SEU_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT emitido pelo Supabase Auth — copie de: Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Storage (Supabase) ─────────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=pizzaria-assets
